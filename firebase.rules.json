{
  "rules": {
    "$other": { ".read": false, ".write": false },

    "lineup": {
      "latest": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['date', 'opponent']) && newData.child('date').isString() && newData.child('date').val().length <= 20"
      },
      "history": {
        ".read": true,
        "$ts": {
          ".write": "!data.exists() && $ts.matches(/^[0-9]+$/) && newData.hasChild('date')"
        }
      },
      "byDate": {
        ".read": true,
        "$date": {
          ".write": true,
          ".validate": "$date.matches(/^[0-9]{8}$/) && newData.hasChild('date')"
        }
      },
      "noGame": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChild('date') && newData.child('date').val().length <= 20"
      }
    },

    "matchup": {
      "latest": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChild('date')"
      }
    },

    "factPepe": {
      "latest": { ".read": true, ".write": true },
      "history": {
        ".read": true,
        "$id": { ".write": "newData.hasChild('content') || !newData.exists()" }
      }
    },

    "factNews": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['title', 'date']) && newData.child('title').val().length <= 200)"
      }
    },

    "roulette": {
      "foods": {
        ".read": true,
        "$id": {
          ".write": true,
          ".validate": "!newData.exists() || newData.hasChild('name')"
        }
      }
    },

    "seatViews": {
      "zonePhotos": {
        ".read": true,
        "$zoneId": {
          "$photoId": {
            ".write": "!newData.exists() || newData.hasChild('photoUrl')"
          }
        }
      },
      "pending": {
        ".read": true,
        "$id": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "!newData.exists() || (newData.hasChild('photoUrl') && newData.child('photoUrl').val().length <= 2000000)"
        }
      },
      "pendingPhotos": {
        ".read": true,
        "$id": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "!newData.exists() || newData.hasChild('photoUrl')"
        }
      },
      "approved": {
        ".read": true,
        "$id": { ".write": true }
      },
      "reports": {
        ".read": true,
        "$id": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "!newData.exists() || (newData.hasChild('comment') && newData.child('comment').isString() && newData.child('comment').val().length <= 500)"
        }
      },
      "stadiumMap": {
        ".read": true,
        ".write": true,
        "hotspots": {
          "$zoneId": { ".write": true }
        }
      }
    },

    "goods": {
      "pending": {
        ".read": true,
        "$id": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "!newData.exists() || (newData.hasChild('imageUrl') && (!newData.child('comment').exists() || newData.child('comment').val().length <= 500))"
        }
      },
      "approved": {
        ".read": true,
        "$id": { ".write": true }
      }
    },

    "prediction": {
      ".read": true,
      "stats": {
        ".write": true,
        ".validate": "newData.hasChild('total') && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('total').val() < 1000000"
      },
      "$date": {
        ".write": "$date.matches(/^[0-9]{8}$/)",
        ".validate": "newData.hasChild('winRate') ? (newData.child('winRate').isNumber() && newData.child('winRate').val() >= 0 && newData.child('winRate').val() <= 100) : true"
      }
    },

    "vote": {
      ".read": true,
      "$date": {
        ".validate": "$date.matches(/^[0-9]{8}$/)",
        "counts": {
          "win": {
            ".write": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000"
          },
          "lose": {
            ".write": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000"
          }
        },
        "users": {
          "$uid": {
            ".write": "newData.hasChildren(['choice', 'at']) && newData.child('choice').isString() && (newData.child('choice').val() === 'win' || newData.child('choice').val() === 'lose') && $uid.matches(/^[a-zA-Z0-9_]{4,80}$/)"
          }
        }
      }
    },

    "chat": {
      "banned": {
        ".read": true,
        "$uid": {
          ".write": true,
          ".validate": "!newData.exists() || newData.hasChild('at')"
        }
      },
      "$date": {
        ".validate": "$date.matches(/^[0-9]{8}$/)",
        "messages": {
          ".read": true,
          "$msgId": {
            ".write": "(!data.exists() && newData.hasChildren(['userId', 'text', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 50 && newData.child('userId').isString() && newData.child('userId').val().length >= 4 && newData.child('userId').val().length <= 80 && newData.child('at').isNumber() && !root.child('chat').child('banned').child(newData.child('userId').val()).exists()) || !newData.exists() || (data.exists() && newData.child('text').val() === data.child('text').val() && newData.child('userId').val() === data.child('userId').val() && newData.child('at').val() === data.child('at').val())",
            ".validate": "newData.hasChildren(['userId', 'text', 'at']) && (!newData.hasChild('likes') || (newData.child('likes').isNumber() && newData.child('likes').val() >= 0 && newData.child('likes').val() < 100000)) && (!newData.hasChild('nickname') || (newData.child('nickname').isString() && newData.child('nickname').val().length <= 10))"
          }
        },
        "likes": {
          ".read": true,
          "_users": {
            "$uid": {
              "$msgId": {
                ".write": "(newData.isNumber() && $uid.matches(/^[a-zA-Z0-9_]{4,80}$/)) || !newData.exists()"
              }
            }
          }
        }
      }
    },

    "users": {
      ".read": true,
      "$uid": {
        ".write": "newData.hasChild('lastSeen') && newData.child('lastSeen').isNumber() && $uid.matches(/^[a-zA-Z0-9_]{4,80}$/)",
        ".validate": "newData.hasChildren(['lastSeen']) && (!newData.hasChild('sessions') || (newData.child('sessions').isNumber() && newData.child('sessions').val() < 100000)) && (!newData.hasChild('nickname') || (newData.child('nickname').isString() && newData.child('nickname').val().length <= 10))"
      }
    },

    "analytics": {
      ".read": true,
      "dau": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{8}$/)",
          "$uid": {
            ".write": "newData.isNumber() && $uid.matches(/^[a-zA-Z0-9_]{4,80}$/)"
          }
        }
      },
      "actions": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{8}$/)",
          "counts": {
            "$action": {
              ".write": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000 && $action.matches(/^[a-z_]{1,50}$/)"
            }
          },
          "users": {
            "$uid": {
              "$action": {
                ".write": "newData.isNumber() && $uid.matches(/^[a-zA-Z0-9_]{4,80}$/) && $action.matches(/^[a-z_]{1,50}$/)"
              }
            }
          }
        }
      },
      "funnel": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{8}$/)",
          "$stage": {
            ".write": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000"
          },
          "_users": {
            "$uid": {
              "$key": { ".write": "newData.isNumber()" }
            }
          }
        }
      },
      "cron": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{8}$/)",
          "$job": {
            ".write": true
          }
        }
      },
      "daily": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "sessions":   { ".write": "newData.isNumber() && newData.val() >= 0" },
          "pageviews":  { ".write": "newData.isNumber() && newData.val() >= 0" },
          "firstVisit": { ".write": "newData.isNumber()" },
          "tabs": {
            "$tab": { ".write": "newData.isNumber() && newData.val() >= 0" }
          },
          "toss": {
            "sessions":  { ".write": "newData.isNumber() && newData.val() >= 0" },
            "pageviews": { ".write": "newData.isNumber() && newData.val() >= 0" },
            "tabs": {
              "$tab": { ".write": "newData.isNumber() && newData.val() >= 0" }
            }
          }
        }
      },
      "roulette": {
        "$date": {
          "$uid": { ".write": "newData.isNumber() && newData.val() >= 0" }
        }
      }
    }
  }
}
