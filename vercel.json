{
  "crons": [
    { "path": "/api/daily-report",     "schedule": "0 0 * * *" },
    { "path": "/api/recap-auto",       "schedule": "0 20 * * *" },
    { "path": "/api/prediction-auto",  "schedule": "0 2 * * *" },
    { "path": "/api/prediction-auto",  "schedule": "0 4 * * *" },
    { "path": "/api/prediction-auto",  "schedule": "30 7 * * *" },
    { "path": "/api/youtube-latest",   "schedule": "0 3 * * *" },
    { "path": "/api/youtube-latest",   "schedule": "0 8 * * *" },
    { "path": "/api/lineup-auto",      "schedule": "30 3 * * *" },
    { "path": "/api/lineup-auto",   "schedule": "30 4 * * *" },
    { "path": "/api/lineup-auto",   "schedule": "30 6 * * *" },
    { "path": "/api/lineup-auto",   "schedule": "30 7 * * *" },
    { "path": "/api/lineup-auto",   "schedule": "30 8 * * *" },
    { "path": "/api/lineup-auto",   "schedule": "30 9 * * *" },
    { "path": "/api/games-crawl",   "schedule": "30 14 * * *" },
    { "path": "/api/games-crawl",   "schedule": "0 16 * * *" },
    { "path": "/api/auto-poll",     "schedule": "0 7 * * *" },
    { "path": "/api/live-monitor",  "schedule": "*/5 9-14 * * *" }
  ],
  "rewrites": [
    { "source": "/q",           "destination": "/index.html" },
    { "source": "/toss/:path*", "destination": "/index.html" },
    { "source": "/toss",        "destination": "/index.html" }
  ]
}
